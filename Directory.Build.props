<Project>
  <!-- Single source of truth for every user-visible and executable version. -->
  <PropertyGroup>
    <Version>2.12.0</Version>
    <AssemblyVersion>2.12.0.0</AssemblyVersion>
    <FileVersion>2.12.0.0</FileVersion>
    <InformationalVersion>2.12.0</InformationalVersion>
    <Company>AI Usage Monitor</Company>
    <Product>AI Usage Monitor</Product>
    <Copyright>Copyright © 2026</Copyright>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
